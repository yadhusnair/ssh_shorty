# Black & white theme for visidata, used by `s --edit`.
# No named colors (green/blue/cyan/yellow) — just your terminal's normal
# foreground/background, plus bold/reverse/underline for emphasis. Installed
# to ~/.visidatarc (skipped if you already have one — see install.sh).
#
# To tweak further: each line below is `options.<name> = '<value>'`.
# Values are made of these keywords, space-separated: bold, underline,
# reverse, italic — plus optionally "on <color>" for a background.
# Leaving a value as '' means "use the terminal's plain default".
# Full option list: run `vd`, then press `Space` and type "options-color".

options.color_default        = ''             # normal cell text
options.color_default_hdr    = 'bold'         # column header row
options.color_current_row    = 'reverse'      # row your cursor is on
options.color_current_col    = 'bold'         # column your cursor is on
options.color_current_hdr    = 'bold reverse' # header of the current column
options.color_key_col        = 'bold'         # key column(s)
options.color_column_sep     = ''             # the │ between columns
options.color_selected_row   = 'bold reverse' # rows you've selected (space)

options.color_menu           = 'reverse'      # top menu bar (File Edit View...)
options.color_menu_active    = 'bold reverse' # highlighted menu item
options.color_menu_spec      = 'bold'         # sheet-specific menu items
options.color_menu_help      = 'reverse'      # help popup

options.color_status         = 'bold'         # bottom status line
options.color_active_status  = 'bold reverse'
options.color_inactive_status = ''
options.color_top_status     = 'underline'
options.color_working        = 'bold'         # "processing..." indicator

options.color_edit_cell      = 'reverse'      # cell you're actively typing into
